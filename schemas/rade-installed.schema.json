{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rhope-ops/RADE/blob/main/schemas/rade-installed.schema.json",
  "title": "RADE install record of one app",
  "description": "One file for each app in RADE\\Config\\installed, named <first 12 hex of the SHA-256 of the lower-case key>.json. Rules: docs/engine.md \"Shared files\". Written by Save-Installed in engine/rade_build.py; tests/engine_test.sh checks the files the engine writes against this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "about", "key", "installed", "lastRun", "steps"],
  "properties": {
    "schema": { "const": "rade-installed/2" },
    "about": { "type": "string" },
    "key": {
      "type": "string",
      "description": "<app folder>/<app name>, plus @ and 12 hex (a short hash of the site address, never the address) for an app with a site marker.",
      "pattern": "^[^/]+/.+$"
    },
    "installed": {
      "description": "The last deploy after which every needed step had PASSED at that version; null until then.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/run" }]
    },
    "lastRun": {
      "description": "The last deploy run and its state.",
      "allOf": [{ "$ref": "#/$defs/run" }],
      "required": ["state"]
    },
    "steps": {
      "type": "object",
      "description": "Step name to its last state, the version, the time and what it made (the undo list).",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "version", "at", "made"],
        "properties": {
          "state": { "enum": ["PASSED", "NEEDS REVIEW", "SKIPPED"] },
          "version": { "type": "string" },
          "at": { "$ref": "#/$defs/at" },
          "made": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "name"],
              "properties": { "kind": { "type": "string" }, "name": { "type": "string" } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "build", "round", "at"],
      "properties": {
        "version": { "type": "string" },
        "build": { "type": "string" },
        "round": { "type": "string" },
        "at": { "$ref": "#/$defs/at" },
        "state": { "enum": ["PASSED", "NEEDS REVIEW", "STOPPED"] }
      }
    }
  }
}
