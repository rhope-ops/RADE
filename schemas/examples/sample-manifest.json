{
  "_doc": "Fake sample for the RADE manifest schema. No real paths, names or sites.",
  "application": {
    "name": "Sample: Test App",
    "folder": "SampleApp",
    "prefix": "SAMPLE",
    "repo": "example-org/sample-app",
    "home": "https://example-org.github.io/sample-app",
    "own": [
      "SAMPLE-*"
    ],
    "knownDirs": [
      [
        "scripts",
        "*.ps1"
      ]
    ]
  },
  "bundles": [
    {
      "out": "scripts/gov/paste/SAMPLE-R01-round-r1.ps1",
      "round": "R01",
      "title": "Round R01: sample check and one guide step",
      "files": [
        {
          "dir": "T01",
          "src": "scripts/gov/SAMPLE-T01-check-r1.ps1"
        },
        {
          "dir": "T02",
          "src": "flow/SAMPLE-T02-import-r1.zip"
        },
        {
          "dir": "T03",
          "src": "scripts/gov/SAMPLE-T03-verify-r1.ps1"
        },
        {
          "dir": "T04",
          "src": "scripts/gov/SAMPLE-T04-optional-r1.ps1"
        }
      ],
      "steps": [
        {
          "name": "T01 Sample check r1",
          "dir": "T01",
          "file": "SAMPLE-T01-check-r1.ps1",
          "needs": [
            "ps"
          ],
          "estimate": 2,
          "note": "Reads this computer only.",
          "help": "Close other PowerShell windows, then run again."
        },
        {
          "name": "T04 Sample optional r1",
          "dir": "T04",
          "file": "SAMPLE-T04-optional-r1.ps1",
          "default": false,
          "estimate": 1,
          "note": "Optional: off unless the user ticks it."
        },
        {
          "name": "T02 Sample import r1",
          "title": "Import the sample file",
          "dir": "T02",
          "file": "SAMPLE-T02-import-r1.zip",
          "kind": "guide",
          "guide": [
            "1. Select \"Open in browser\" above.",
            "2. In the \"File name\" box, press Ctrl+V.",
            "3. Select \"Import\"."
          ],
          "url": "https://example.invalid/import",
          "doneText": "Imported",
          "makes": [
            {
              "kind": "flow",
              "name": "Sample flow"
            }
          ]
        },
        {
          "name": "T03 Sample verify r1",
          "dir": "T03",
          "file": "SAMPLE-T03-verify-r1.ps1",
          "needs": [
            "ps"
          ],
          "estimate": 1,
          "after": [
            "T02 Sample import r1"
          ],
          "note": "Checks the import."
        }
      ],
      "collect": [
        {
          "dir": "T01",
          "name": "SAMPLE-T01-result-r1.txt",
          "step": "T01 Sample check r1"
        }
      ],
      "cleanup": [
        {
          "path": "T00",
          "kind": "dir"
        }
      ],
      "apps": [
        {
          "name": "Sample app",
          "summary": "A fake application for the schema test.",
          "steps": [
            "T01 Sample check r1",
            "T02 Sample import r1"
          ],
          "mode": "test"
        },
        {
          "name": "Sample app (deploy)",
          "summary": "The same fake app as a deploy.",
          "mode": "deploy",
          "version": "1.0.0",
          "start": "T01/SAMPLE-T01-check-r1.ps1",
          "steps": [
            "T01 Sample check r1",
            "T04 Sample optional r1",
            "T02 Sample import r1",
            "T03 Sample verify r1"
          ]
        }
      ],
      "release": "v1.0.0",
      "fetch": [
        {
          "dir": "T02",
          "src": "flow/SAMPLE-data-r1.txt"
        }
      ]
    }
  ]
}
