# Opt-in file for scripts/pii_guard.py (pre-push hook and the pii-guard GitHub Action).
# Below: exact strings that are allowed although they look like personal data, one per line.
# `skip: <path or glob>` excludes a path.
# Only the owner adds entries. Agents never add one to get past a block (AGENTS.md "Personal data").
# DoD tier and its entries: approved by the Administrator, 2026-11-15 (docs/DECISIONS.md).
profile: dod
usaf.dps.mil
smil.mil
area.example.smil.mil
notsmil.mil
skip: assets/logo/*.png
skip: tests/fixture-app/flow/SAMPLE-T02-import-r1.zip
# Code standard and audit settings (the keys: the header of scripts/check_settings.py).
code-max-line-chars: 200
code-c1-safety: on
code-c2: full
