{
  "_doc": "UI standard v1: the one home of the colors, sizes, gaps, field widths and type of every RADE window and app window (the Administrator, 2026-11-20; docs/ui-standard.md). engine/rade_build.py writes the block between the ui-tokens markers in engine/rade_ui.ps1 from this file (python3 engine/rade_tokens.py --write) and stops a build when that block is old; scripts/ui_tokens.py checks the contrast of every pair and writes the CSS block of index.html. Sizes are pixels at 100 % Windows scaling. A color's 'system' is the SystemColors role it takes while a Windows contrast theme is on. A face's 'file' is its font in engine/fonts (scripts/build_fonts.py makes them); '' = none yet: the window uses the face's fallback.",
  "standard": "v1",
  "colors": {
    "White": { "hex": "#FFFFFF", "system": "Window", "use": "surface: the window, the card, labels and text boxes" },
    "Ink": { "hex": "#1B2430", "system": "WindowText", "use": "text in boxes" },
    "Navy": { "hex": "#0B2545", "system": "WindowText", "use": "card text, the light's line" },
    "Gray": { "hex": "#5A6573", "system": "GrayText", "use": "muted text: second lines, notes, labels" },
    "Blue": { "hex": "#00539F", "system": "Highlight", "use": "the primary button's fill, progress, Your turn" },
    "OnBlue": { "hex": "#FFFFFF", "system": "HighlightText", "use": "text on the primary button" },
    "Link": { "hex": "#00539F", "system": "HotTrack", "use": "links" },
    "Focus": { "hex": "#0B2545", "system": "HotTrack", "use": "the 2 px focus ring" },
    "Face": { "hex": "#FFFFFF", "system": "ButtonFace", "use": "a button's fill" },
    "FaceInk": { "hex": "#0B2545", "system": "ControlText", "use": "a button's text" },
    "Edge": { "hex": "#7A8794", "system": "ControlText", "use": "a button's and a box's edge, the header line" },
    "Hair": { "hex": "#E3E8EE", "system": "GrayText", "use": "a button under the pointer, thin lines" },
    "Track": { "hex": "#7F93A8", "system": "GrayText", "use": "the bar track, the edge of a button that is not available" },
    "Off": { "hex": "#E9ECF0", "system": "ButtonFace", "use": "a button that is not available, a pressed button" },
    "OffInk": { "hex": "#555555", "system": "GrayText", "use": "the text of a button that is not available" },
    "Yellow": { "hex": "#FFD520", "system": "Highlight", "use": "the light: your turn" },
    "Red": { "hex": "#8B1A1A", "system": "WindowText", "use": "FAILED, NEEDS REVIEW, the one destructive action" },
    "Green": { "hex": "#2E8540", "system": "Highlight", "use": "the bar of a run that passed" },
    "GreenInk": { "hex": "#1F6B31", "system": "WindowText", "use": "the word PASSED" }
  },
  "pairs": [
    { "fg": "Ink", "bg": "White", "kind": "text" },
    { "fg": "Navy", "bg": "White", "kind": "text" },
    { "fg": "Gray", "bg": "White", "kind": "text" },
    { "fg": "Blue", "bg": "White", "kind": "text" },
    { "fg": "Link", "bg": "White", "kind": "text" },
    { "fg": "OnBlue", "bg": "Blue", "kind": "text" },
    { "fg": "FaceInk", "bg": "Face", "kind": "text" },
    { "fg": "FaceInk", "bg": "Hair", "kind": "text" },
    { "fg": "FaceInk", "bg": "Off", "kind": "text" },
    { "fg": "OffInk", "bg": "Off", "kind": "text" },
    { "fg": "Red", "bg": "Off", "kind": "text" },
    { "fg": "Red", "bg": "White", "kind": "text" },
    { "fg": "White", "bg": "Red", "kind": "text" },
    { "fg": "GreenInk", "bg": "White", "kind": "text" },
    { "fg": "Focus", "bg": "White", "kind": "non-text" },
    { "fg": "Edge", "bg": "White", "kind": "non-text" },
    { "fg": "Track", "bg": "White", "kind": "non-text" },
    { "fg": "Blue", "bg": "White", "kind": "non-text" },
    { "fg": "Green", "bg": "White", "kind": "non-text" },
    { "fg": "Navy", "bg": "Yellow", "kind": "non-text" }
  ],
  "sizes": { "ActionW": 160, "WideW": 240, "ActionH": 40, "CompactW": 96, "CompactH": 30, "LinkH": 28, "BarTop": 11, "M": 4, "Inset": 24 },
  "gaps": { "G1": 4, "G2": 8, "G3": 12, "G4": 16, "G6": 24 },
  "fields": { "FieldS": 240, "FieldM": 420, "FieldL": 600 },
  "faces": {
    "title": { "family": "Sofia Sans Condensed SemiBold", "file": "", "fallback": "Segoe UI Semibold" },
    "text": { "family": "Sofia Sans", "file": "", "fallback": "Segoe UI" },
    "strong": { "family": "Sofia Sans SemiBold", "file": "", "fallback": "Segoe UI Semibold" },
    "mono": { "family": "Consolas", "file": "", "fallback": "Consolas" }
  },
  "styles": {
    "Sent": { "face": "title", "pt": 22, "style": "", "use": "the headline of a card" },
    "Word": { "face": "title", "pt": 15, "style": "Bold", "use": "the word RADE in the logo block" },
    "Body": { "face": "text", "pt": 12, "style": "", "use": "paragraphs, step lines, the help line" },
    "Small": { "face": "text", "pt": 10, "style": "", "use": "second lines, notes, box text" },
    "SmallB": { "face": "strong", "pt": 10, "style": "", "use": "the line in capitals, labels, every button" },
    "Link": { "face": "strong", "pt": 10, "style": "Underline", "use": "links (underlined: not color alone)" },
    "Turn": { "face": "strong", "pt": 12, "style": "Bold", "use": "Your turn (bold: R35; the SemiBold file when Bold is not in it)" },
    "Mono": { "face": "mono", "pt": 9, "style": "", "use": "the Record's text box" }
  }
}
